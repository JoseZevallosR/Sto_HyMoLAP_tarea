library(ggplot2)
url <- "https://fluviotech.com/hydrostations/api/series/"
params <- list(
gauge_id = "PE_1113346",
start = "1981-01-01",
end = "2025-12-31"
)
response <- GET(url, query = params)
stop_for_status(response)
result <- content(response, as = "text", encoding = "UTF-8")
result <- fromJSON(result, flatten = TRUE)
df <- as.data.frame(result$data)
df$date <- as.Date(df$date)
ggplot(df, aes(x = date)) +
geom_line(aes(y = flow_obs, color = "Observed streamflow")) +
geom_line(aes(y = flow_sim, color = "Simulated streamflow")) +
labs(
title = result$gauge_name,
x = "Date",
y = "Discharge (m³/s)",
color = ""
) +
theme_minimal() +
theme(
legend.position = "bottom"
)
