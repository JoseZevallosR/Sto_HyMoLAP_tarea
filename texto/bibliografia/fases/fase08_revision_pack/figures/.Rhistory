# Cargar el paquete para el diseño de Latin Hypercube
library(lhs)
library(rjags)
library(ggplot2)
rm(list = ls())
# Definir la función del simulador
simulator_function <- function(x, theta) {
theta * x^2
}
sample_data <- function(n_samples, simulator_function) {
set.seed(123)  # Para reproducibilidad
# Generar la muestra de Latin Hypercube para 20 puntos en [0,1] x [1,3]
lhs_samples <- randomLHS(n_samples, 2)
# Transformar las muestras a los rangos deseados
x_samples <- lhs_samples[,1]                   # valores en [0,1]
theta_samples <- 1 + 2 * lhs_samples[,2]       # valores en [1,3]
# Crear la matriz de diseño X usando todas las combinaciones (producto cartesiano)
X <- expand.grid(x = x_samples, theta = theta_samples)
# Evaluar la función simuladora en todas las combinaciones
y_simulated <- mapply(simulator_function, X$x, X$theta)
# Retornar X y y_simulated como lista
return(list(X = as.matrix(X), y_simulated = y_simulated))
}
# 1. Definir la "realidad" oculta que queremos estimar (función sintética)
true_function <- function(x) {
exp(x) - 1  # Función real desconocida en el ejemplo del artículo
}
# 2. Generar datos de observación con ruido
set.seed(123)  # Para reproducibilidad
x_train <- seq(0, 1, length.out = 10)  # 10 puntos de observación
y_train <- true_function(x_train) + rnorm(length(x_train), mean = 0, sd = 0.05)  # Añadir ruido
mod_string = " model {
for (i in 1:N) {
y_train[i] ~ dnorm(mu[i], prec)
mu[i] = prediction(posterior, X, y_simulated, x_train[i], theta)
}
theta ~ dnorm(0.0, 1.0/1.0e6)
prec ~ dgamma(1.0/2.0, 1.0*1500.0/2.0)
## Initial guess of variance based on overall
## variance of education variable. Uses low prior
## effective sample size. Technically, this is not
## a true 'prior', but it is not very informative.
sig2 = 1.0 / prec
sig = sqrt(sig2)
} "
data <- sample_data(n_samples = 5, simulator_function)
# Mostrar resultados
X <- data$X           # Matriz de diseño X
y_simulated <- data$y_simulated # Vector de respuestas simuladas
store_posterior <- function() {
posterior <- c(
beta_0 = -0.8911435,
beta_1 = 1.9903964,
beta_theta = 0.7194873,
omega_t = 0.1181933,
omega_x = 1.3128866,
sigma_g = 1.0004208
)
return(posterior)
}
posterior = store_posterior()
# 5. Crear la lista de datos para JAGS
data_jags = list(
x_train = x_train,
y_train = y_train,
N = length(y_train),  # Se define explícitamente el número de observaciones
X = X,
y_simulated = y_simulated,
posterior = posterior
)
params1 = c("theta","sig")
inits1 = function(){
inits = list("theta" = rnorm(1, 0.0, 100.00), "prec" = rgamma(1,1.0,1.0))
}
mod1 = jags.model(textConnection(mod_string),data = data_jags, inits = inits1, n.chains = 3)
posterior = store_posterior()
