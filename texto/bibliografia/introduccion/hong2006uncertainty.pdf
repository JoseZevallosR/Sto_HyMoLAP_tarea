   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: Uncertainty assessment; Hydrology: Precipitation; Hydrology: Remote sensing; Hydrology: Estimation and forecasting</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Uncertainty quantification of satellite precipitation estimation and Monte Carlo assessment of the error propagation into hydrologic response</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Yang Hong, Kuo&amp;hyphen;lin Hsu, Hamid Moradkhani, Soroosh Sorooshian</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>http://dx.doi.org/10.1029/2005WR004398, doi:10.1029/2005WR004398, ensemble prediction, error propagation, error quantification, rain&amp;hyphen;runoff modeling, remote sensing precipitation, uncertainty assessment</pdf:Keywords>
