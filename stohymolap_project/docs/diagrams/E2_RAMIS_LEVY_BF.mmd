%% E2: RAMIS estocastico Levy + flujo base
flowchart LR
    PEFF["Peff"] --> MC["Monte Carlo (n trayectorias)"]
    LEVY["Ruido alfa-estable<br/>(alpha, beta, sigma)"] --> MC
    BF["Flujo base (c_r, k_b, S0_b)"] --> MC
    MC --> ENS["Ensemble de caudales"]
    ENS --> QMEAN["Qmean"]
    ENS --> QUANT["Cuantiles q05..q95<br/>banda IC95 (q025, q975)"]
    QMEAN --> DET["Metricas deterministicas"]
    QUANT --> UNC["Metricas de incertidumbre<br/>PICP, PINAW, MPIW, Winkler"]
